ConfigureParams: <<
  --mandir=%i/share/man \
  --with-gd-inc=%p/include \
  --with-gd-lib=%p/lib \
  --sysconfdir=%p/etc/%n \
  --datadir=%p/share/%n \
  --sbindir=%p/lib/cgi-bin \
  --with-httpd-conf=%p/etc/apache2/conf.d
<<

CompileScript: <<
  ./configure %c
  nagpaths="prefix=%p LOGDIR=%p/var/log/%n CGIDIR=%p/lib/cgi-bin"
  make nagios $nagpaths
  make cgis $nagpaths
  make contrib $nagpaths
  make modules $nagpaths
  ls -l
<<

InstallScript: <<
  #!/bin/bash -ev
  nagpaths="prefix=%i LOGDIR=%i/var/log/%n CFGDIR=%i/etc/%n CGIDIR=%i/lib/cgi-bin"
  make install $nagpaths
  make install-config $nagpaths
  # Do not do make install-init - Fink uses Daemonic

  # update daemonic init script if necessary
  daemonic install %N

<<

ConfFiles: <<
  %p/etc/nagios/cgi.cfg
  %p/etc/nagios/nagios.cfg
  %p/etc/nagios/objects
  %p/etc/nagios/objects/commands.cfg
  %p/etc/nagios/objects/contacts.cfg
  %p/etc/nagios/objects/localhost.cfg
  %p/etc/nagios/objects/printer.cfg
  %p/etc/nagios/objects/switch.cfg
  %p/etc/nagios/objects/templates.cfg
  %p/etc/nagios/objects/timeperiods.cfg
  %p/etc/nagios/objects/windows.cfg
  %p/etc/nagios/resource.cfg
<<

PreRmScript: <<
  # clean up
  if [ $1 != "upgrade" ]; then
        daemonic remove %N
  fi
<<

DaemonicFile: <<
        <service>
        <description>Nagios service and network monitoring daemon</description>
        <message> Nagios service and network monitoring</message>
        
        <daemon name="%N">
                <executable background="no">%p/bin/%n</executable>
                <parameters>start</parameters>
        </daemon>
        
        </service>
<<

DescUsage: <<
To configure nagios to start on boot:
'sudo daemonic enable %N' to create a StartupItem for it.

To start nagios manually:
'sudo %p/bin/%n -v %p/etc/%n/%n.cfg'
<<