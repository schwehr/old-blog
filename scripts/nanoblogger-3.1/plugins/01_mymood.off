# NanoBlogger MyMood plugin that replaces mood placeholders
# with mood images, controled by moods.conf

# modifies $My_Mood placeholder for templates

MOODS_DIR="$BLOG_DIR/moods"

: ${MOODS_URL:=$BLOG_URL/moods}

if [ -d "$MOODS_DIR" ]; then
	load_moods(){
	if [ -f "$MOODS_DIR/moods.conf" ]; then
		echo ""
		echo "moods:"
		echo ""
		cat "$MOODS_DIR/moods.conf" | sed -e '/^[\#\]/d; /^$/d' | cut -d" " -f1
		echo ""
		echo "enter your mood or leave blank if you feel the same"
		read -p "$NB_PROMPT" My_Mood
		echo ""
		nb_msg "generating mood icon ..."
		if [ -z "$My_Mood" ] ; then
			if [ -f "$MOODS_DIR/mymood.txt" ] ; then
				My_Mood=$(< "$MOODS_DIR/mymood.txt")
			fi
		fi
		echo " $My_Mood " > "$SCRATCH_FILE"
		# store current mood here
		echo " $My_Mood " > "$MOODS_DIR/mymood.txt"
		mood_lines=`cat "$MOODS_DIR/moods.conf" |sed -e '/^$/d; /[\#\]/d' |grep -n "" |cut -c1-2 |sed -e '/[\:\]/ s///g'`
		mood_list=`cat "$MOODS_DIR/moods.conf" |sed -e '/^$/d; /[\#\]/d'`
		for mood in $mood_lines ; do
			mood_line=`echo "$mood_list" | sed -n "$mood"p`
			if [ ! -z "$mood_line" ] ; then
				mood_var=`echo "$mood_line" |cut -d" " -f1 | sed -e '/[\*\]/ s//[*]/'`
				mood_img=`echo "$mood_line" |cut -d" " -f3`
				create_moods
			fi
		done
	fi
	}

	create_moods(){
	mood_url=`echo "$MOODS_URL/$mood_img" | sed -e '/[\/\]/ s//\\\\\//g'`
	#sed_script='/[ ]'$mood_var'[ ]/ s// <img src="'$mood_url'" alt="'$mood_var'" border="0" \/> /g'
	sed_script='/\([ ]'$mood_var'[ ]\|[ ]'$mood_var'$\|^'$mood_var'[ ]\)/ s// <img src="'$mood_url'" alt="'$mood_var'" border="0" \/> /g'
	TEMP_MOOD=$(< "$SCRATCH_FILE")
	sed -e "$sed_script" > "$SCRATCH_FILE" <<-EOF
		$TEMP_MOOD
	EOF
	}

	load_moods
	NB_My_Mood=$(< "$SCRATCH_FILE")
fi

